{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/assets/(.*)\\.(mp4|webm|webp|jpg|jpeg|png|svg|avif)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
